# Copy to .env and fill in. .env is git-ignored; never commit real keys.
LANGSMITH_API_KEY=            # required by the containerized server (development "lite mode") and for tracing
MODEL=openai:gpt-4o-mini      # provider:model; any tool-calling model works
OPENAI_API_KEY=               # the key for whichever provider MODEL names
OPENAI_BASE_URL=              # optional: OpenAI-compatible endpoint (gateway, Azure OpenAI front door, internal proxy); leave empty for api.openai.com
