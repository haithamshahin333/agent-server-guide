{
  "uid": "agent-server-lifecycle",
  "title": "Agent Server: request lifecycle",
  "tags": [
    "agent-server",
    "langgraph",
    "queue"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 2,
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(lg_api_workers_max, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(lg_api_workers_max, namespace)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "agent-server",
          "value": "agent-server"
        }
      },
      {
        "name": "langsmith_url",
        "label": "LangSmith URL",
        "type": "textbox",
        "hide": 0,
        "skipUrlSync": false,
        "query": "https://smith.langchain.com",
        "current": {
          "selected": false,
          "text": "https://smith.langchain.com",
          "value": "https://smith.langchain.com"
        },
        "options": [
          {
            "selected": true,
            "text": "https://smith.langchain.com",
            "value": "https://smith.langchain.com"
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Prometheus alerts",
      "type": "link",
      "url": "http://localhost:9090/alerts",
      "targetBlank": true
    },
    {
      "title": "LangSmith traces (per-run time to first token, per-tool time)",
      "type": "link",
      "url": "${langsmith_url}",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Runs waiting for a worker",
      "description": "Pending runs (api-server gauge). Healthy: ~0. Sustained > 0 while 'Free worker slots' is 0 = capacity.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(lg_api_num_pending_runs{namespace=\"$namespace\", container=\"api-server\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Free worker slots",
      "description": "Unused run slots across all queue workers (N_JOBS_PER_WORKER slots each). 0 = saturated.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(lg_api_workers_available{namespace=\"$namespace\", container=\"queue\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Queue workers",
      "description": "Queue worker processes currently scraped: containers on Compose, pods on Kubernetes (where KEDA can scale the queue Deployment on pending runs).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(lg_api_workers_max{namespace=\"$namespace\", container=\"queue\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Time to answer, p95 (last 5 m)",
      "description": "HTTP latency of /runs/wait and /runs/stream on the api-server. Those routes hold the connection for the whole run, so this is what a caller experienced end to end. Red above the placeholder target; set your own.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lg_api_http_requests_latency_bucket{namespace=\"$namespace\", container=\"api-server\", path=~\".*/runs/(wait|stream)\"}[5m])))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1500.0
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Where do the seconds go? One request through the server",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Anatomy of a run: mean time per stage (stacked) vs what the client saw",
      "description": "Mean milliseconds per stage, stacked; the stack should roughly reach the dashed client line (the gap is API/DB overhead and streaming). 1 = capacity (add slots/replicas). 2 = the factory does per-run work that belongs at module scope. 3 = the model provider. 4 = the agent's own tools and later turns.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(rate(lg_api_run_queue_wait_time_1st_attempt_sum{namespace=\"$namespace\", container=\"queue\"}[$__rate_interval])) / sum(rate(lg_api_run_queue_wait_time_1st_attempt_count{namespace=\"$namespace\", container=\"queue\"}[$__rate_interval])))",
          "legendFormat": "1. waiting for a worker slot",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(rate(agent_graph_factory_duration_ms_sum{namespace=\"$namespace\", container=\"queue\", access_context=\"threads.create_run\"}[$__rate_interval])) / sum(rate(agent_graph_factory_duration_ms_count{namespace=\"$namespace\", container=\"queue\", access_context=\"threads.create_run\"}[$__rate_interval])))",
          "legendFormat": "2. building the graph (factory)",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(rate(agent_model_call_duration_ms_sum{namespace=\"$namespace\", container=\"queue\", first=\"true\"}[$__rate_interval])) / sum(rate(agent_model_call_duration_ms_count{namespace=\"$namespace\", container=\"queue\", first=\"true\"}[$__rate_interval])))",
          "legendFormat": "3. first model call",
          "refId": "C",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "clamp_min((sum(rate(lg_api_run_execution_latency_sum{namespace=\"$namespace\", container=\"queue\"}[$__rate_interval])) / sum(rate(lg_api_run_execution_latency_count{namespace=\"$namespace\", container=\"queue\"}[$__rate_interval]))) - ((sum(rate(agent_graph_factory_duration_ms_sum{namespace=\"$namespace\", container=\"queue\", access_context=\"threads.create_run\"}[$__rate_interval])) / sum(rate(agent_graph_factory_duration_ms_count{namespace=\"$namespace\", container=\"queue\", access_context=\"threads.create_run\"}[$__rate_interval]))) or vector(0)) - ((sum(rate(agent_model_call_duration_ms_sum{namespace=\"$namespace\", container=\"queue\", first=\"true\"}[$__rate_interval])) / sum(rate(agent_model_call_duration_ms_count{namespace=\"$namespace\", container=\"queue\", first=\"true\"}[$__rate_interval]))) or vector(0)), 0)",
          "legendFormat": "4. rest of execution (tools, later model turns, checkpoints)",
          "refId": "D",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(rate(lg_api_http_requests_latency_sum{namespace=\"$namespace\", container=\"api-server\", path=~\".*/runs/(wait|stream)\"}[$__rate_interval])) / sum(rate(lg_api_http_requests_latency_count{namespace=\"$namespace\", container=\"api-server\", path=~\".*/runs/(wait|stream)\"}[$__rate_interval])))",
          "legendFormat": "client end to end (/runs/wait|stream)",
          "refId": "E",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "client end to end (/runs/wait|stream)"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tail latency per stage, p95, against your target",
      "description": "Red line = a placeholder target; set it to your own SLO in the panel thresholds. The server's latency histograms have coarse buckets (10/100/500/1000/5000 ms...), so a p95 between 1 s and 5 s is interpolated. For the exact number of a specific run read run_completed_in_ms from the per-run log record (module 10).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lg_api_run_queue_wait_time_1st_attempt_bucket{namespace=\"$namespace\", container=\"queue\"}[$__rate_interval])))",
          "legendFormat": "waiting for a slot p95",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_graph_factory_duration_ms_bucket{namespace=\"$namespace\", container=\"queue\", access_context=\"threads.create_run\"}[$__rate_interval])))",
          "legendFormat": "graph factory p95",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_model_call_duration_ms_bucket{namespace=\"$namespace\", container=\"queue\", first=\"true\"}[$__rate_interval])))",
          "legendFormat": "first model call p95",
          "refId": "C",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lg_api_run_execution_latency_bucket{namespace=\"$namespace\", container=\"queue\"}[$__rate_interval])))",
          "legendFormat": "whole execution p95 (server histogram)",
          "refId": "D",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lg_api_http_requests_latency_bucket{namespace=\"$namespace\", container=\"api-server\", path=~\".*/runs/(wait|stream)\"}[$__rate_interval])))",
          "legendFormat": "client end to end p95",
          "refId": "E",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Graph factory: build time p95 by caller, builds per second by tier",
      "description": "The graph factory runs on EVERY get_graph(): threads.create_run on queue workers (one per run), assistants.read / threads.read / threads.update on the api-server (schemas, state, Studio). Nothing is memoized by the server. Healthy: single-digit ms once warm. The server itself logs a warning above 100 ms and an error above 250 ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, access_context) (rate(agent_graph_factory_duration_ms_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p95 {{access_context}}",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (container, access_context) (rate(agent_graph_factory_duration_ms_count{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "builds/s {{container}} {{access_context}}",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "builds/s.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot",
                  "dash": [
                    2,
                    4
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Client-observed latency p95 by API route",
      "description": "/threads/{thread_id}/runs/wait and /runs/stream are as long as the run itself (by design). Every other route should be tens of ms; a slow /threads, /assistants/search or /threads/{thread_id}/state points at the api-server tier or Postgres, not at the agent.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(lg_api_http_requests_latency_bucket{namespace=\"$namespace\", container=\"api-server\"}[$__rate_interval])))",
          "legendFormat": "{{path}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Capacity: is the queue the bottleneck?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Queue depth vs worker capacity",
      "description": "Pending should return to zero within seconds. Pending above capacity for minutes means arrivals outpace the workers: add workers or slots (on Kubernetes, KEDA scales the queue Deployment with a target of N_JOBS_PER_WORKER pending runs per replica).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(lg_api_num_pending_runs{namespace=\"$namespace\", container=\"api-server\"})",
